{
    "name": "ember-restaurant-static",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "NODE_ENV=development node server.js",
        "build": "node script/build.js",
        "start": "NODE_ENV=production node server.js",
        "format": "oxfmt",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "json-server": "0.17.4"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^5.0.5",
        "oxfmt": "^0.73.0",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": ">=22.22.1",
        "pnpm": "^9 || ^10 || ^11"
    },
    "packageManager": "pnpm@10.34.9",
    "pnpm": {
        "onlyBuiltDependencies": [
            "sharp",
            "esbuild",
            "unrs-resolver"
        ]
    }
}